# Ball is Lyfe - Environment Configuration Template
# 
# Copy this file to .env.local for local development
# Never commit .env files with real secrets to version control
# Always use this template and keep actual env files in your local machine only

# ==========================================
# Environment
# ==========================================
NODE_ENV=local

# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# Database Configuration
# ==========================================
# MongoDB connection string - Choose one:
#
# OPTION A: Local MongoDB (Recommended for offline development)
#   - Requires: MongoDB installed locally
#   - Connection: mongodb://localhost:27017/ball-is-lyfe-dev
#   - Benefit: No internet needed, full offline development
#   - Setup: See README.md "Local MongoDB Setup" section
#
# OPTION B: Team Dev MongoDB Cluster
#   - Requires: Team-provided dev connection string
#   - Connection: mongodb+srv://dev-user:password@cluster-dev.mongodb.net/ball-is-lyfe-dev?retryWrites=true&w=majority
#   - Benefit: Shared test data with team in staging environment
#   - Status: Active
#
# OPTION C: Production MongoDB (⚠️ Only for emergency debugging)
#   - Requires: Production credentials
#   - Connection: mongodb+srv://prod-user:password@cluster-prod.mongodb.net/ball-is-lyfe?retryWrites=true&w=majority
#   - Benefit: Real production data
#   - Drawback: Risk of accidental data modification
#
# Choose the option that works best for your workflow:
MONGODB=mongodb://localhost:27017/ball-is-lyfe-dev

# ==========================================
# Authentication & Security
# ==========================================
# JWT Secret for access tokens (generate a random string)
# Example: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-a-random-value

# JWT Secret for refresh tokens (generate a different random string)
REFRESH_SECRET=your-refresh-secret-here-generate-a-random-value

# ==========================================
# GraphQL Configuration
# ==========================================
# CORS origin - where requests come from (local development)
ORIGIN=http://localhost:3000

# GraphQL endpoint URL (local development)
GRAPHQL_ADDRESS=http://localhost:3000/graphql

# ==========================================
# Third-party Services
# ==========================================
# Google OAuth Client ID (optional, leave empty if not using Google auth)
# Get this from Google Cloud Console
GOOGLE_CLIENT_ID=

# ==========================================
# Logging
# ==========================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=debug

# ==========================================
# Environment Notes
# ==========================================
# Three environments (local → dev → production):
#
# LOCAL (.env.local - Your Machine):
#   - NODE_ENV=local
#   - MONGODB: Local MongoDB or the team dev cluster
#   - URLs: http://localhost:3000
#   - Purpose: Development and testing on your machine
#   - Offline capable with local MongoDB
#
# DEV (.env.dev - Staging/Testing):
#   - NODE_ENV=development
#   - MONGODB: Dev MongoDB cluster (to be created)
#   - URLs: https://dev.recleaguenation.com
#   - Purpose: Testing features before production
#   - Deployed from develop branch
#   - Status: Active
#
# PRODUCTION (.env or platform config - Live):
#   - NODE_ENV=production
#   - MONGODB: Production MongoDB cluster (separate credentials)
#   - URLs: https://recleaguenation.com
#   - Purpose: Live application for users
#   - Deployed from main branch
#   - Status: Active and live now
